# ---------------------------------------------------------------- required --

# Supabase Postgres connection string for project eiaimbjpvmkpwzwhbqmf.
# Supabase dashboard > Connect. Use the SESSION POOLER (port 5432) — Payload runs
# migrations, which the transaction pooler (6543) does not support. The direct host
# (db.<ref>.supabase.co) is IPv6-only and will not resolve from Vercel.
#
# Shape:
#   postgresql://postgres.eiaimbjpvmkpwzwhbqmf:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
#
# URL-ENCODE the password. Any of @ / : ? # [ ] % in it will break URL parsing and
# surface as "cannot connect to Postgres: Invalid URL". Substitutions:
#   @ %40    / %2F    : %3A    ? %3F    # %23    [ %5B    ] %5D    % %25
# Simplest alternative: reset the database password to letters and digits only.
DATABASE_URL=

# Any long random string. Generate one with: openssl rand -base64 32
# Use a DIFFERENT value in production than locally.
PAYLOAD_SECRET=


# ------------------------------------------------------------- not yet used --
# Uncomment as each piece gets built. Nothing below is needed to run the app today.

# Supabase Auth — public keys are safe to expose; the service role key is server-only
# and must never be prefixed NEXT_PUBLIC_.
# NEXT_PUBLIC_SUPABASE_URL=https://eiaimbjpvmkpwzwhbqmf.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Stripe — registrations, sponsorship, membership, merch.
# Use test keys locally and live keys in production.
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# Vercel Analytics needs no environment variables at all — the client posts to
# /_vercel/insights on our own domain. Nothing to configure here or on Vercel.
